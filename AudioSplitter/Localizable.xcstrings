                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg clip"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg clips"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
